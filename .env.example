# Bu dosyayı ".env" adıyla kopyalayıp düzenleyin. Hepsi isteğe bağlıdır.

# Veritabanı şifresi (ilk kurulumdan sonra değiştirirseniz veritabanı volume'unu da sıfırlamanız gerekir)
POSTGRES_PASSWORD=borsa

# tradingview: gerçek veri (15 dk gecikmeli) | demo: internetsiz deneme verisi
DATA_PROVIDER=tradingview

# Kaç yıllık geçmiş tutulsun
HISTORY_YEARS=5

# Geçmiş indirirken aynı anda kaç sembol çekilsin (çok artırmayın, TradingView sınırlayabilir)
FETCH_WORKERS=3

# Seans içinde anlık fiyatların kaç saniyede bir yenileneceği
LIVE_POLL_SECONDS=60

# Telegram bildirimleri: @BotFather'dan bot oluşturup token'ı, @userinfobot'tan chat id'nizi alın
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (İsteğe bağlı) Ücretli TradingView aboneliğiniz varsa tarayıcı çerezlerinizdeki
# sessionid / sessionid_sign değerleri ile gecikmesiz veri alınabilir
TV_SESSION=
TV_SESSION_SIGN=

# Bilgisayardaki portlar
APP_PORT=8000
DB_PORT=5432
